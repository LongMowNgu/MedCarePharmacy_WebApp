@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MedCare - Nhà thuốc trực tuyến</title>
    <link rel="stylesheet" href="~/css/main.css">
</head>
<body>
    <header class="top-header">
        <div class="top-bar">
            <span>📍 Tìm nhà thuốc</span>
            <a asp-controller="Customer" asp-action="Orders">Tra cứu đơn hàng</a>
            <span>Hotline: 1800 0000</span>
        </div>

        <div class="main-header">
            <a class="logo" asp-controller="Home" asp-action="Index"><span>✚</span> MedCare</a>

            <form class="search-box" onsubmit="event.preventDefault(); location.href='@Url.Action("Products", "Customer")?q=' + encodeURIComponent(this.q.value)">
                <input id="searchInput" name="q" type="text" placeholder="Tìm kiếm thuốc, vitamin, sản phẩm...">
                <button type="submit">🔍</button>
            </form>

            <div class="header-actions">
                <span id="authArea"></span>
                <a asp-controller="Customer" asp-action="Cart" class="link-btn">🛒 Giỏ hàng <b id="cartCount">0</b></a>
            </div>
        </div>

        <nav class="nav">
            <a class="active" asp-controller="Home" asp-action="Index">Trang chủ</a>
            <a asp-controller="Customer" asp-action="Products" asp-route-cat="Thuốc">Thuốc</a>
            <a asp-controller="Customer" asp-action="Products" asp-route-cat="Vitamin">Vitamin & Khoáng chất</a>
            <a asp-controller="Customer" asp-action="Products" asp-route-cat="Dược mỹ phẩm">Dược mỹ phẩm</a>
            <a asp-controller="Customer" asp-action="Products" asp-route-cat="Thiết bị y tế">Thiết bị y tế</a>
            <a asp-controller="Customer" asp-action="Products" asp-route-cat="Chăm sóc cá nhân">Chăm sóc cá nhân</a>
            <a asp-controller="Customer" asp-action="Products" asp-route-cat="Mẹ & Bé">Mẹ & Bé</a>
            <a asp-controller="Customer" asp-action="Consultation">💬 Tư vấn trực tuyến</a>
        </nav>
    </header>

    <main>
        <section class="hero">
            <div class="hero-content">
                <p class="eyebrow">NHÀ THUỐC TRỰC TUYẾN</p>
                <h1>Chăm sóc sức khỏe<br>cho cả gia đình</h1>
                <p>Sản phẩm đa dạng · Nguồn gốc rõ ràng · Giao hàng nhanh</p>
                <button class="primary-btn" onclick="document.getElementById('products').scrollIntoView({behavior:'smooth'})">Mua sắm ngay</button>
            </div>
            <div class="hero-icon">💊</div>
        </section>

        <section class="section">
            <div class="section-title">
                <div>
                    <p class="eyebrow">KHÁM PHÁ</p>
                    <h2>Danh mục nổi bật</h2>
                </div>
            </div>

            <div class="categories">
                <a class="category" asp-controller="Customer" asp-action="Products" asp-route-cat="Thuốc">💊<span>Thuốc</span></a>
                <a class="category" asp-controller="Customer" asp-action="Products" asp-route-cat="Vitamin">🍊<span>Vitamin</span></a>
                <a class="category" asp-controller="Customer" asp-action="Products" asp-route-cat="Dược mỹ phẩm">🧴<span>Dược mỹ phẩm</span></a>
                <a class="category" asp-controller="Customer" asp-action="Products" asp-route-cat="Thiết bị y tế">🩺<span>Thiết bị y tế</span></a>
                <a class="category" asp-controller="Customer" asp-action="Products" asp-route-cat="Chăm sóc cá nhân">🧼<span>Chăm sóc cá nhân</span></a>
                <a class="category" asp-controller="Customer" asp-action="Products" asp-route-cat="Mẹ & Bé">👶<span>Mẹ & Bé</span></a>
            </div>
        </section>

        <section class="section" id="products">
            <div class="section-title">
                <div>
                    <p class="eyebrow">SẢN PHẨM</p>
                    <h2>Sản phẩm nổi bật</h2>
                </div>
                <select id="sortSelect">
                    <option value="default">Sắp xếp</option>
                    <option value="low">Giá thấp → cao</option>
                    <option value="high">Giá cao → thấp</option>
                </select>
            </div>

            <div id="productList" class="products"></div>
        </section>

        <section class="health-banner">
            <div>
                <p class="eyebrow">MEDCARE CARE</p>
                <h2>Đặt thuốc dễ dàng,<br>chăm sóc sức khỏe an tâm.</h2>
                <p>Hệ thống MedCare Pharmacy tích hợp ASP.NET Core MVC & Web API.</p>
            </div>
            <div class="health-icon">🩺</div>
        </section>
    </main>

    <footer>
        <div>
            <div class="logo"><span>✚</span> MedCare</div>
            <p>Nhà thuốc trực tuyến — giao diện hệ thống quản lý dược phẩm.</p>
            <p style="margin-top:10px">
                <a asp-controller="Customer" asp-action="Login">Đăng nhập</a> ·
                <a asp-controller="Customer" asp-action="Products">Sản phẩm</a> ·
                <a asp-controller="Customer" asp-action="Orders">Đơn hàng</a>
            </p>
        </div>
        <div>
            <h3>Hỗ trợ</h3>
            <p>Chính sách giao hàng</p>
            <p>Hướng dẫn mua hàng</p>
            <p>Chính sách đổi trả</p>
            <p><a asp-controller="Customer" asp-action="Consultation">Tư vấn với dược sĩ</a></p>
        </div>
        <div>
            <h3>Liên hệ</h3>
            <p>Hotline: 1800 0000</p>
            <p>Email: support@medcare.vn</p>
            <p style="margin-top:12px">
                <a asp-controller="Customer" asp-action="Login" asp-route-role="pharmacist">Khu vực Dược sĩ</a><br>
                <a asp-controller="Customer" asp-action="Login" asp-route-role="admin">Khu vực Quản trị</a>
            </p>
        </div>
    </footer>

    <div id="toast" class="toast"></div>

    <script src="~/js/api.js"></script>
    <script src="~/js/main.js"></script>
    <script src="~/js/auth.js"></script>
    <script src="~/js/cart.js"></script>
    <script src="~/js/customer.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            if (typeof updateCartCount === "function") updateCartCount();
            if (typeof renderHomeProducts === "function") renderHomeProducts();
            const s = document.getElementById("sortSelect");
            if (s) s.addEventListener("change", renderHomeProducts);
        });
    </script>
</body>
</html>