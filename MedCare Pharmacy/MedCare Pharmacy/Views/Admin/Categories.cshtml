@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản lý danh mục - Admin</title>
    <link rel="stylesheet" href="~/css/main.css">
    <link rel="stylesheet" href="~/css/admin.css">
</head>
<body>
    <div class="dash-layout">
        <aside class="dash-sidebar">
            <a class="brand" asp-controller="Admin" asp-action="Index">
                <span>✚</span> MedCare
            </a>

            <div class="side-sep">Quản trị</div>

            <nav>
                <a asp-controller="Admin" asp-action="Index">📊 Tổng quan</a>
                <a asp-controller="Admin" asp-action="Medicines">💊 Thuốc</a>
                <a class="active" asp-controller="Admin" asp-action="Categories">🗂️ Danh mục</a>
                <a asp-controller="Admin" asp-action="Suppliers">🏭 Nhà cung cấp</a>
                <a asp-controller="Admin" asp-action="NhapKho">📥 Nhập kho</a>
                <a asp-controller="Admin" asp-action="Users">👥 Người dùng</a>
                <a asp-controller="Admin" asp-action="Reports">📈 Báo cáo</a>
            </nav>

            <div class="side-sep">Liên kết</div>

            <nav>
                <a asp-controller="Home" asp-action="Index">🏠 Trang chủ khách hàng</a>
                <a asp-controller="Pharmacist" asp-action="Index">💼 Khu vực Dược sĩ</a>
            </nav>
        </aside>

        <main class="dash-main">
            <div class="dash-header">
                <div>
                    <div class="breadcrumb">Admin / Danh mục</div>
                    <h1>Quản lý danh mục</h1>
                </div>

                <div style="display:flex;gap:8px;align-items:center">
                    <span id="authArea"></span>
                </div>

                <button class="btn" id="btnAddCat">+ Thêm danh mục</button>
            </div>

            <div class="panel">
                <div class="table-wrap">
                    <table class="tbl">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Tên danh mục</th>
                                <th>Mô tả</th>
                                <th>Số sản phẩm</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody id="catBody"></tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>

    <div id="toast" class="toast"></div>

    <script src="~/js/api.js"></script>
    <script src="~/js/main.js"></script>
    <script src="~/js/auth.js"></script>
    <script src="~/js/admin.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            if (typeof requireRole === "function") requireRole("admin");
            if (typeof renderAuthArea === "function") renderAuthArea();
            if (typeof initCategoriesPage === "function") initCategoriesPage();
        });
    </script>
</body>
</html>