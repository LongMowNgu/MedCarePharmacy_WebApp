@{
    ViewData["Title"] = "Tư vấn trực tuyến";
}

<h1 style="margin-bottom:18px">💬 Tư vấn với Dược sĩ</h1>

<div class="chat-layout customer-chat">
    <div class="chat-panel" id="chatRoot">
        <div class="chat-header">
            <div class="chat-peer">
                <div class="conv-avatar big">💊</div>
                <div>
                    <div class="peer-name">Dược sĩ MedCare</div>
                    <div class="peer-sub">Trực tuyến · Phản hồi trong vài phút</div>
                </div>
            </div>
        </div>

        <div class="chat-messages" id="chatMessages"></div>

        <div class="chat-input-bar">
            <input type="file" id="chatImage" accept="image/jpeg,image/png,image/webp,image/gif" style="display:none">

            <!-- label for = mở file dialog bằng HTML, không phụ thuộc JS -->
            <label for="chatImage" id="chatImageBtn" class="btn muted" title="Gửi ảnh"
                   style="flex-shrink:0;padding:8px 12px;cursor:pointer;margin:0;display:inline-flex;align-items:center;user-select:none">
                📷
            </label>

            <div style="flex:1;display:flex;flex-direction:column;gap:6px;min-width:0">
                <img id="chatImagePreview" alt="Xem trước"
                     style="display:none;max-height:80px;max-width:160px;border-radius:8px;object-fit:contain">
                <textarea id="chatInput" rows="1" placeholder="Nhập câu hỏi cho dược sĩ... (Enter để gửi)"></textarea>
            </div>
            <button type="button" id="chatSend" class="primary-btn">Gửi ➤</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/customer.js"></script>
    <script src="~/js/chat.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            if (typeof updateCartCount === "function") updateCartCount();
            if (typeof renderAuthArea === "function") renderAuthArea();
            if (typeof initCustomerChat === "function") initCustomerChat();
        });
    </script>
}