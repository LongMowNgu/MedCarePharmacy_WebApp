@{
    ViewData["Title"] = "Đơn thuốc của tôi";
}

<h1 style="margin-bottom:18px">Đơn thuốc của tôi</h1>

<label class="rx-drop" for="rxUpload" style="display:block;cursor:pointer">
    <input id="rxUpload" type="file" style="display:none" accept="image/png,image/jpeg,application/pdf">
    <div class="ic">📎</div>
    <div style="font-size:18px;font-weight:700;margin-top:8px">Tải ảnh đơn thuốc</div>
    <div class="text-muted" style="margin-top:6px">Hỗ trợ PNG, JPG, JPEG, PDF</div>
</label>

<h3 class="mb-16">Đơn thuốc đã tải</h3>

<div id="rxList" class="rx-list"></div>

@section Scripts {
    <script src="~/js/customer.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            if (typeof updateCartCount === "function") updateCartCount();
            if (typeof renderAuthArea === "function") renderAuthArea();
            if (typeof initPrescriptionPage === "function") initPrescriptionPage();
        });
    </script>
}