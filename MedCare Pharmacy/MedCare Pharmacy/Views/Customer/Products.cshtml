@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Danh sách sản phẩm - MedCare</title>
    <link rel="stylesheet" href="~/css/main.css">
    <link rel="stylesheet" href="~/css/customer.css">
</head>
<body>
    <header class="top-header">
        <div class="top-bar">
            <span>📍 Tìm nhà thuốc</span>
            <a asp-controller="Customer" asp-action="Orders">Tra cứu đơn hàng</a>
            <span>Hotline: 1800 0000</span>
        </div>

        <div class="main-header">
            <a class="logo" asp-controller="Home" asp-action="Index">
                <span>✚</span> MedCare
            </a>

            <form class="search-box" onsubmit="event.preventDefault(); location.href='@Url.Action("Products", "Customer")?q=' + encodeURIComponent(this.q.value)">
                <input name="q" id="searchInput" type="text" placeholder="Tìm kiếm thuốc, vitamin, sản phẩm...">
                <button type="submit" id="searchBtn">🔍</button>
            </form>

            <div class="header-actions">
                <span id="authArea"></span>
                <a asp-controller="Customer" asp-action="Cart" class="link-btn">
                    🛒 Giỏ hàng <b id="cartCount">0</b>
                </a>
            </div>
        </div>

        <nav class="nav">
            <a asp-controller="Home" asp-action="Index">Trang chủ</a>
            <a class="active" asp-controller="Customer" asp-action="Products">Thuốc & Sản phẩm</a>
            <a asp-controller="Customer" asp-action="Consultation">💬 Tư vấn trực tuyến</a>
            <a asp-controller="Customer" asp-action="Prescription">Đơn thuốc</a>
            <a asp-controller="Customer" asp-action="Orders">Đơn hàng</a>
        </nav>
    </header>

    <main class="page-wrap">
        <section class="section">
            <div class="section-title">
                <div>
                    <p class="eyebrow" id="catSubtitle">DANH MỤC</p>
                    <h2 id="catTitle">Tất cả sản phẩm</h2>
                </div>

                <select id="sortSelect">
                    <option value="default">Sắp xếp</option>
                    <option value="low">Giá thấp → cao</option>
                    <option value="high">Giá cao → thấp</option>
                </select>
            </div>

            <div id="productList" class="products"></div>
        </section>
    </main>

    <footer>
        <div>
            <div class="logo">
                <span>✚</span> MedCare
            </div>
            <p>Nhà thuốc trực tuyến - Hệ thống quản lý bán thuốc tích hợp.</p>
        </div>

        <div>
            <h3>Hỗ trợ</h3>
            <p>Chính sách giao hàng</p>
            <p>Hướng dẫn mua hàng</p>
        </div>

        <div>
            <h3>Liên hệ</h3>
            <p>Hotline: 1800 0000</p>
            <p>Email: support@medcare.vn</p>
        </div>
    </footer>

    <div id="toast" class="toast"></div>

    <script src="~/js/api.js"></script>
    <script src="~/js/main.js"></script>
    <script src="~/js/auth.js"></script>
    <script src="~/js/cart.js"></script>
    <script src="~/js/customer.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            if (typeof updateCartCount === "function") updateCartCount();
            if (typeof renderAuthArea === "function") renderAuthArea();
            if (typeof initProductsPage === "function") {
                initProductsPage();
            } else if (typeof initHomePage === "function") {
                initHomePage();
            }
        });
    </script>
</body>
</html>