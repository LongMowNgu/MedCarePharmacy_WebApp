@{
    ViewData["Title"] = "Danh sách sản phẩm";
}

<section class="section">
    <div class="section-title">
        <div>
            <p class="eyebrow" id="catSubtitle">DANH MỤC</p>
            <h2 id="catTitle">Tất cả sản phẩm</h2>
        </div>

        <select id="sortSelect">
            <option value="default">Sắp xếp</option>
            <option value="low">Giá thấp → cao</option>
            <option value="high">Giá cao → thấp</option>
        </select>
    </div>

    <div id="productList" class="products"></div>
</section>

@section Scripts {
    <script src="~/js/customer.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            if (typeof updateCartCount === "function") updateCartCount();
            if (typeof renderAuthArea === "function") renderAuthArea();
            if (typeof initProductsPage === "function") {
                initProductsPage();
            } else if (typeof initHomePage === "function") {
                initHomePage();
            }
        });
    </script>
}